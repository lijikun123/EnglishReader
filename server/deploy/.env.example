# Copy this file to .env on the VPS and replace every CHANGE_ME value.
POSTGRES_DB=kreader
POSTGRES_USER=kreader
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
KREADER_JWT_SECRET=CHANGE_ME_TO_A_32_BYTE_OR_LONGER_RANDOM_SECRET
KREADER_JWT_ISSUER=https://api.example.com
KREADER_JWT_AUDIENCE=kreader-android
# Keep this false when the API is public. Temporarily use true only to create
# the owner's first account through a private SSH tunnel, then return it to false.
KREADER_ALLOW_REGISTRATION=false
KREADER_MAX_BUNDLE_BYTES=26214400
KREADER_MAX_JSON_BYTES=65536
KREADER_MAX_AUTH_ATTEMPTS_PER_MINUTE=10

# Needed only when enabling the `edge` Docker Compose profile after DNS is ready.
KREADER_DOMAIN=api.example.com
